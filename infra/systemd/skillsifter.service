[Unit]
Description=SkillSifter Go API __APP_VERSION__
After=network.target postgresql.service

[Service]
Type=simple
User=skillsifter
Group=skillsifter
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=__APP_DIR__/backend/.env
Environment=SKILLSIFTER_ENV=production
Environment=SKILLSIFTER_VERSION=__APP_VERSION__
Environment=SKILLSIFTER_REVISION=__APP_REVISION__
Environment=RESUME_STORAGE_PATH=/var/lib/skillsifter/resumes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/skillsifter
ExecStart=__APP_DIR__/backend/skillsifter
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
